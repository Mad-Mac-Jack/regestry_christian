{
  "description": "ChrisDesktoop workspace for custom development and browsing.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "chrisdesktoop.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Desktop"
  ],
  "friendly_name": "ChrisDesktoop",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "kasmweb/desktop:develop",
      "uncompressed_size_mb": 2500,
      "available_tags": [
        "develop"
      ]
    }
  ]
}
